--!strict
-- Фанаты студии (FansService, Formulas.fanChange / fanMultiplier / expoFans) — общий счётчик
-- студии, как в Game Dev Tycoon (у франшиз свои фанаты — Config/Franchises, это другое).
-- Базовая фича: есть с запуска. Числа подобраны в tools/balance_sim.py (--all): первый Rebirth
-- почти не сдвигается, фанаты копятся днями, большие числа — только от хитов и со временем.
--
-- Релиз: оценка 6+ приносит gain[оценка] × stageGain[этап студии] фанатов (реклама — чуть больше,
-- adGainShare). Оценка 5 — без изменений. Ниже 5 фанаты уходят: lossShare[оценка] от текущих,
-- но не меньше lossMin[оценка] × stageGain (не ниже 0). Мусором фанатов не нафармить: любая
-- игра ниже 5 только отнимает, а потеря в процентах растёт вместе с фанатской базой.
--
-- Продажи: доход релиза, полки хитов (и частей франшиз — это тоже релизы) × fanMultiplier:
-- 1 + maxBonus × fans / (fans + halfFans) — убывающая отдача, к maxBonus (+50%) только
-- приближается и никогда не обгоняет платную рекламу (+100%). 0 фанатов — ровно ×1 (floor):
-- новичок ничего не теряет, а ушедшие фанаты снижают множитель обратно к ×1.

local Fans = {
	-- Прирост за релиз по оценке 1..10 (до множителя этапа). Индексы 1–5 — 0: там потеря или ничего
	gain = { 0, 0, 0, 0, 0, 2, 5, 10, 16, 25 },
	-- Потеря за плохую игру по оценке 1..4: доля текущих фанатов и минимум (× stageGain этапа)
	lossShare = { 0.06, 0.035, 0.02, 0.01 },
	lossMin = { 60, 40, 25, 10 },
	-- Множитель прироста/минимума потери по этапу студии (studioLevel 1..4: гараж … 3-й этаж)
	stageGain = { 1, 1.5, 2, 3 },
	-- Активная реклама: прирост × (1 + бонус рекламы × adGainShare) — при +100% это лишь +25%
	-- к приросту. Потерю реклама не уменьшает (донат не спасает от плохой игры)
	adGainShare = 0.25,

	-- Выставка (ExpoService, раз в час): победа / 2-е / 3-е место / оценка ≥ expoHighScore без
	-- места (× stageGain). Слабый результат фанатов не отнимает. Только онлайн-игрокам и только
	-- если выставка состоялась (хватило участников) — против фарма в пустых серверах
	expoWin = 400,
	expoSecond = 200,
	expoThird = 120,
	expoHigh = 40,
	expoHighScore = 8,

	-- Множитель продаж: 1 + maxBonus × fans / (fans + halfFans), не ниже floor
	maxBonus = 0.5,
	halfFans = 300_000, -- 05.11: было 1_000_000 — к концу забега всего +6%, фанатов не было заметно; теперь ~+16% (Rebirth −1 ч)
	floor = 1,

	-- Rebirth: остаётся такая доля фанатов (студия новая, но часть фанатов ждёт её игр)
	rebirthKeep = 0.25,
	-- Защита сохранения от мусора
	maxFans = 1_000_000_000,
}

return Fans
