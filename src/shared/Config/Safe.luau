--!strict
-- Сейф в парке (7.16, SafeService): 6-значный код знает только владелец игры.
-- Код, приз и лимит победителей НЕ хранятся здесь и вообще в репозитории (он публичный):
-- владелец задаёт их в игре, сервер кладёт в DataStore SafeCode_v1
-- и рассылает остальным серверам через MessagingService. Клиент кода не видит никогда.
--
-- РЕКОМЕНДУЕМЫЙ ПУТЬ — панель владельца: кнопка 🔐 справа вверху (видна только владельцам,
-- атрибут SafeAdmin ставит сервер) → поля «Код» (скрыт, есть «показать»), «Приз», «Лимит», «До»
-- и кнопки «Задать» / «Убрать» / «Статус». Чат-команда ниже — только запасной путь: опечатка
-- в «/safe» (например «/saf set 482913») уйдёт в общий чат вместе с кодом, и сервер это не перехватит.
--
-- Команды (только ownerUserIds и создатель игры; у группы — её владелец):
--   /safe set 482913 cash=500000 limit=100 until=2026-11-12   — новый код (cash, limit, until необязательны)
--   /safe clear                                                 — убрать код («Скоро здесь будет приз»)
--   /safe status                                                — что сейчас в сейфе (видно только владельцу)
-- cash понимает 500000, 500k, 20m; until — дата UTC (до 23:59:59 этого дня) или 2026-11-12T18:00.

local Safe = {
	-- UserId владельцев, кому можно /safe (кроме создателя игры: его сервер находит сам).
	-- Список общий с Config/Admin.ownerUserIds: владельцев определяет server/Services/OwnerAccess
	ownerUserIds = {} :: { number },

	codeLength = 6,
	-- Приз по умолчанию (решение владельца 05.11: ровно $500 000)
	defaultCash = 500_000,
	-- Защита от опечатки в команде
	maxCash = 1_000_000_000,
	-- Лимит победителей, если в команде нет limit= (0 — без лимита)
	defaultLimit = 100,
	maxLimit = 1_000_000,

	-- Хранилище и канал между серверами
	dataStore = "SafeCode_v1",
	recordKey = "current",
	winnersPrefix = "winners_", -- + id кода: глобальный счётчик победителей (UpdateAsync)
	topic = "SafeCode_v1",
	-- Подстраховка MessagingService: раз в столько секунд перечитать DataStore
	refreshSeconds = 90,

	-- Защита от перебора (на сервере, попытки хранятся в профиле — смена сервера не обнуляет)
	triesPerMinute = 3,
	triesPerHour = 20,
	-- Ввод только рядом с сейфом
	promptDistance = 10,
	maxTryDistance = 16,

	-- Раскладка: рядом с ломбардом (владелец 10.11) — смещение в осях ларька (X — вбок, Z — вперёд),
	-- поворот относительно ларька. Место занято — сервер ищет рядом (searchStep/searchRings)
	pawnOffset = Vector3.new(9, 0, 1),
	pawnYawOffset = 180, -- владелец 10.11: дверцей в другую сторону
	-- Запасная раскладка, если ломбарда нет: у фонтана Астры (StartPark.landscapeFountain = 43.47, 0, 11.65). Место подобрано
	-- по assets/models/astra-park/layout.json: между фонтаном и тропинкой 30°, в стороне от
	-- деревьев, урны и Promenade. yaw — поворот лица (+Z) в градусах, лицом к спавну
	landscapePosition = Vector3.new(46.7, 0, 19.9),
	landscapeYaw = 247,
	-- Без парка Астры (фонтана нет): между скамейками 6 и 1, до начала тропинок к участкам
	fallbackPosition = Vector3.new(20, 0, 0),
	fallbackYaw = 270,
	-- Если место занято (в Studio что-то поставили), сервер ищет рядом свободное по кругу
	searchStep = 3,
	searchRings = 4,
	footprint = Vector3.new(4.2, 5, 4.2),
}

return Safe
