--!strict
-- «Вид студии» (StudioCamera на клиенте): камера над своим участком, почти изометрия.
-- Участок 60×60, +Z — передний край (вход, кнопки покупки): камера смотрит с этой стороны.

local Camera = {
	-- Угол камеры над горизонтом и узкий FOV: чем уже FOV, тем дальше камера и меньше перспектива
	pitchDegrees = 50,
	fieldOfView = 25,
	-- Расстояние от точки взгляда до камеры (studs): при FOV 25 весь участок 60×60 в кадре
	distance = 175,
	minDistance = 130,
	maxDistance = 240,
	-- Точка взгляда: центр участка, чуть выше пола
	targetHeight = 4,
	-- Колёсико: на сколько studs за щелчок; щипок меняет расстояние пропорционально
	zoomStep = 12,
	-- Плавный переход в вид студии и при зуме
	tweenSeconds = 0.8,
	zoomTweenSeconds = 0.15,

	-- Полупрозрачность передних стен и потолка (LocalTransparencyModifier, только у этого игрока)
	fadeTransparency = 0.85,
	-- Детали, чей центр выше пола участка больше чем на столько studs, — потолок, крыша, верхние этажи
	fadeHeight = 6,
	-- Передние стены: центр ближе к +Z, чем самая передняя мебель из Config/Upgrades, плюс запас
	frontMargin = 2,
	-- Передние детали ниже этого (кнопки покупки, ковры, пороги) не трогаем
	frontMinHeight = 3,

	-- Авто-вид, когда игрок садится за свой ПК (тумблер рядом с 🎥)
	autoViewDefault = true,
	-- Сколько секунд видна подсказка рядом с кнопкой
	hintSeconds = 2.5,
}

return Camera
