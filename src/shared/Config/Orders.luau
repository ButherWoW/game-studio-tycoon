--!strict
-- Заказы дня (OrderService, доска на участке): «сделай игру такого жанра с оценкой не ниже N — получи деньги».
-- 5 заказов в день (смена в 00:00 UTC, как у ежедневных заданий). Выпустил игру нужного жанра с
-- оценкой не ниже минимальной — заказ выполнен, деньги сразу. Не дотянул оценку — заказ НЕ отменяется
-- и не сгорает: игру можно переделать и сдать позже в тот же день (просьба владельца 07.11).
-- Награда — минуты дохода студии (RewardService.incomeForMinutes), растёт с минимальной оценкой.

local Orders = {
	perDay = 5,
	-- Минимальные оценки пяти заказов по этапу студии (studioLevel 1..4): от лёгкого к трудному
	minScores = {
		{ 5, 5, 6, 6, 7 }, -- гараж
		{ 6, 6, 7, 7, 8 }, -- офис
		{ 6, 7, 7, 8, 9 }, -- 2-й этаж
		{ 7, 7, 8, 9, 9 }, -- 3-й этаж
	} :: { { number } },
	-- Награда в минутах дохода по минимальной оценке (ближайшая снизу, если точной нет)
	rewardMinutes = { [5] = 1.5, [6] = 2.5, [7] = 4, [8] = 6.5, [9] = 10, [10] = 15 } :: { [number]: number },
	-- Доска: смещение от центра участка (в координатах участка, вбок от здания) и размер
	board = {
		offset = Vector3.new(-34, 0, 20),
		size = Vector3.new(8, 5.6, 0.4),
		-- С офисом доска висит на задней глухой стене 1-го этажа, между левой и правой парами постеров
		-- (постеры на x = ±14.5 и ±20, ширина ~4; при x = -11.6 доска перекрывала постер, владелец 10.11):
		-- центр в координатах участка, лицом (+Z детали) в зал
		-- Владелец 10.11: на задней стене доска всё равно за постерами (x −11..11 — постеры гаража) —
		-- переносим на левую боковую стену 1-го этажа, у входа (z 12..20 свободно), лицом в зал (+X)
		officeOffset = Vector3.new(-28.6, 5.8, 16),
		officeYaw = 90,
	},
}

-- Минимальные оценки на день для этапа студии
function Orders.scoresFor(studioLevel: number): { number }
	local index = math.clamp(math.floor(studioLevel), 1, #Orders.minScores)
	return Orders.minScores[index]
end

-- Награда (минут дохода) за минимальную оценку
function Orders.rewardFor(minScore: number): number
	local best = Orders.rewardMinutes[math.clamp(math.floor(minScore), 5, 10)]
	return best or 2.5
end

return Orders
