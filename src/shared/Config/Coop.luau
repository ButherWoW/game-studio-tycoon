--!strict
-- Совместная разработка (CoopService на сервере, CoopController на клиенте).
-- Хозяин за своим ПК зовёт игрока с сервера в текущую игру; гость остаётся за своим ПК
-- и помогает «удалённо»: проект получает очки от мощности студии гостя. Доход делится.

local Coop = {}

-- Доля мощности студии гостя (сумма очков/с его техники), которая идёт в проект хозяина
Coop.guestPowerShare = 0.5
-- Без техники гость всё равно что-то делает: столько очков/с (до множителя темпа проекта)
Coop.guestMinPower = 1

-- Деление дохода релиза: хозяину hostShare, гостю остальное
Coop.hostShare = 0.6
-- Гость получает долю, только если помогал за ПК хотя бы столько секунд и столько от времени
-- разработки после вступления (иначе всё хозяину — защита от «зашёл и ушёл»)
Coop.minGuestSeconds = 10
Coop.minGuestShare = 0.4
-- Потолок доли гостя: столько минут его собственного дохода (защита от перекачки денег на альта)
Coop.guestCapMinutes = 10
-- Опыт сезона гостю за совместный релиз (хозяин получает обычный опыт за свою игру)
Coop.guestSeasonXp = 40

-- Приглашение висит столько секунд, потом сгорает
Coop.inviteSeconds = 20
-- После конца совместного проекта хозяин может звать снова через столько секунд
Coop.cooldownSeconds = 60
-- Между приглашениями (кнопка «Позвать») — не чаще
Coop.inviteCooldown = 5
-- Минимум секунд до релиза, чтобы позвать (в последние секунды смысла нет)
Coop.minRemainingSeconds = 8

return Coop
