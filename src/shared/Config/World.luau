--!strict
-- Границы карты (владелец 07.11: «невидимая стена вокруг, чтобы игроки не выпадали»).
-- Стены ставит WorldService.ensureGround по краю земли (Baseplate), размер земли — по кольцу участков.
-- Спасение от падения: ниже fallY игрок возвращается на свой участок или к спавну (WorldService.rescueFallen).

local World = {
	boundary = {
		height = 150, -- высота невидимой стены, studs
		thickness = 4, -- толщина, studs
	},
	-- Игрок ниже этой высоты считается упавшим за карту
	fallY = -30,
	-- Как часто проверяем падение, секунд
	fallCheckSeconds = 1,
	-- Общая засветка (владелец 07.11: «много света, очень ярко», пол и стены белые): экспозиция и
	-- яркость Lighting не выше этих значений (WorldService.start)
	lighting = {
		exposure = -0.4,
		maxBrightness = 2,
	},
	-- Трава (владелец 07.11: «сделай траву HD-текстурами, пусть выглядит настоящей»): настоящий террейн
	-- Grass поверх земли парка (материал со своей текстурой и 3D-травинками Terrain.Decoration), плоская
	-- плита Baseplate остаётся под ним невидимой и держит коллизию. Цвет задаёт Terrain:SetMaterialColor
	grass = {
		terrain = true,
		depth = 8, -- толщина слоя террейна под землёй, studs (кратно 4)
		color = Color3.fromRGB(88, 150, 66),
		decoration = true,
	},
	-- Фонтан в парке крупнее (масштаб вокруг центра основания)
	fountainScale = 1.7,
}

return World
