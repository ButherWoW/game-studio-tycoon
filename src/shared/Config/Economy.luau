--!strict
-- Числа экономики для Formulas. Цель (issue #1): гараж -> офис за 11–15 минут,
-- в гараже потолок оценки ~7–8, 9–10 — только с большой командой.
-- Отчёт #2: в офисе выпадали 9–10 почти всегда. Теперь (симуляция, см. PR fix/report2-economy):
-- офис с командой — в среднем ~7.4, 9 — у трети игр при идеальном фокусе и отличной теме,
-- 10 — только с доп. бонусами (тренд, праздник, патч, VIP, легенда); повтор сочетания — минус.

local Economy = {
	-- Вес «попадания в рецепт жанра» и «количества очков» в оценке (в сумме 1)
	balanceWeight = 0.4,
	qualityWeight = 0.6,
	-- quality = log10(1 + очки) / qualityLogDivisor; 5 -> качество 1.0 при 100 000 очков
	qualityLogDivisor = 5,
	-- Тема сдвигает оценку: (fit - 1) * topicFitStrength. ×1.2 -> +0.6, ×0.7 -> -0.9
	topicFitStrength = 3,
	-- Случайный разброс оценки, ±
	reviewNoise = 0.75,
	-- Доход = revenueBase * оценка^2 * бонусы
	revenueBase = 20,
	-- +3% к доходу за каждое очко/с купленной техники (конец гаража ~+27%), не больше +150%
	revenuePerPower = 0.03,
	maxPowerBonus = 1.5,
	-- Предметы студии ускоряют разработку не больше чем на эту долю (сумма speed в Config/Upgrades)
	maxUpgradeSpeed = 0.5,
	-- +50% к доходу за каждый уровень студии (было +25%; подняли вместе с criticExpectation,
	-- чтобы доход офиса и дальше почти не упал из-за более низких оценок)
	studioLevelBonus = 0.5,
	-- Ожидания критиков по этапам (studioLevel): столько вычитается из оценки до округления.
	-- От большой студии ждут большего — иначе на этаже и в небоскрёбе всегда 10
	criticExpectation = { 0, 1.2, 1.9, 2.9 },
	-- Повтор: сочетание жанр+тема уже было среди последних repeatHistory игр —
	-- штраф repeatPenalty за каждое совпадение, но не больше repeatPenaltyMax
	repeatHistory = 4,
	repeatPenalty = 0.7,
	repeatPenaltyMax = 1.5,
	-- Сиквелы геймпасса «Авто-релиз» получают такую долю штрафа за повтор (платная фича не должна резать доход)
	sequelRepeatFactor = 0.5,
}

return Economy
