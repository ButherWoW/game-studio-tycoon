--!strict
-- Админ-панель владельца (AdminService, клиент AdminPanel, кнопка 🛠 справа вверху).
-- Кто владелец — server/Services/OwnerAccess (тот же способ, что у сейфа): ownerUserIds ниже и
-- Config/Safe.ownerUserIds, создатель игры, владелец группы-создателя. Списки пустые — панель
-- доступна только создателю игры (или владельцу группы). UserId в репозиторий не пишем без нужды:
-- репозиторий публичный, а создателя сервер находит сам.
--
-- Каждое действие сервер проверяет заново (владелец, типы, диапазоны, частота), пишет в warn
-- Output сервера и в аналитику: кастомное событие AdminAction (Config/Analytics.events.admin),
-- поле — имя действия. Деньги из панели в экономику аналитики не идут (Config/Analytics.ignore).
--
-- Опасные действия (кик, бан, сброс профиля) — в два шага: сервер присылает токен подтверждения,
-- он живёт confirmSeconds и годится только для того же действия и того же игрока.
--
-- «Тестовый сервер»: сдвиг дня контента (волны ContentDrops и обновления по средам Config/Features)
-- действует на весь сервер, поэтому включается только в Studio или на закрытом сервере, куда
-- панель телепортирует владельца (TeleportService:ReserveServer), и только пока на сервере нет никого,
-- кроме владельцев. На обычном сервере игроки ничего не замечают.

local Admin = {
	-- UserId, кому можно в панель (кроме создателя игры / владельца группы — их сервер находит сам)
	ownerUserIds = {} :: { number },

	-- Пределы одной операции (защита от опечатки)
	maxCash = 1_000_000_000_000, -- $ за раз, выдать или забрать
	maxResearchPoints = 1_000_000, -- ОИ за раз
	maxContentDay = 400, -- «день после запуска» на тестовом сервере (400 — заведомо всё вышло)
	maxEventMinutes = 120, -- событие дня / золотой час из панели, минут
	defaultEventMinutes = 15,

	-- Частота: не чаще minInterval с и не больше burst запросов за burstWindow с
	minInterval = 0.25,
	burst = 12,
	burstWindow = 10,

	-- Подтверждение опасных действий: столько секунд живёт токен
	confirmSeconds = 10,

	-- Тексты
	announceMaxLength = 200, -- объявление на сервер (фильтр Roblox для всех + TextSafe)
	announceSeconds = 8, -- сколько висит плашка объявления
	reasonMaxLength = 120, -- причина кика/бана

	-- Бан: DataStore, ключ banKeyPrefix .. UserId = { reason, untilAt (0 — навсегда), by, at }.
	-- Проверка при входе (PlayerAdded); сбой DataStore — пускаем (не банить всех из-за сбоя)
	banStore = "Bans_v1",
	banKeyPrefix = "u_",
	banDays = { 1, 7, 30, 0 } :: { number }, -- варианты в панели (0 — навсегда)
	maxBanDays = 3650,
}

return Admin
